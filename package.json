{
  "name": "walletlens",
  "version": "1.2.0",
  "description": "WalletLens: paid x402 API for EVM wallet reports, portfolio snapshots, Robinhood Stock Tokens, and transaction history.",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:x402": "node --env-file=.env --import tsx scripts/test-x402-payment.ts",
    "test:x402:smart": "node --env-file=.env --import tsx scripts/test-x402-smart-account.ts",
    "test:aegis-relay": "node --env-file=.env --import tsx scripts/test-aegis-relay-smoke.ts",
    "analytics:recent": "node --env-file=.env --import tsx scripts/analytics-recent.ts",
    "check:discovery": "node --env-file=.env --import tsx scripts/check-agent-discovery.ts",
    "mcp": "node --env-file=.env --import tsx packages/walletlens-mcp/src/walletlens-mcp.ts",
    "cdk": "cdk",
    "deploy:aws": "cdk deploy --profile wallyweb",
    "destroy:aws": "cdk destroy --profile wallyweb"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.54.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "@x402/express": "^2.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "serverless-http": "^4.0.0",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "aws-cdk": "^2.1134.0",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.8.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@coinbase/cdp-sdk": {
      "axios": "^1.19.0"
    },
    "ws@^8.0.0": "^8.21.1"
  }
}
