ALCHEMY_API_KEY=
MY_WALLET_ADDRESS=0xYourReceivingWalletHere
PORT=3000

# Keep true while developing locally. Set false in AWS/prod.
X402_DEV_BYPASS=true
X402_PRICE_USD=0.02
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Required when using the CDP production facilitator.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

ROOT_DOMAIN=wallyweb.com
CUSTOM_DOMAIN=walletlens.wallyweb.com
PUBLIC_BASE_URL=https://walletlens.wallyweb.com

# Free live preview demo wallet. Prefer a simple Base wallet with a few tokens.
PREVIEW_WALLET_ADDRESS=0x52E29e0d2Aa49bfBfC548C0A9F2196F4aa51f3ea
PREVIEW_WALLET_CHAINS=base
PREVIEW_CACHE_TTL_SECONDS=600

# Salt used to hash IP addresses in request analytics logs.
ANALYTICS_IP_SALT=replace-with-random-string

# Local paid-call test wallet. Never commit a real private key.
X402_TEST_PRIVATE_KEY=
X402_TEST_ENDPOINT=portfolio
X402_TEST_BASE_URL=https://walletlens.wallyweb.com
X402_TEST_ADDRESS=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045
X402_TEST_CHAINS=base,ethereum
X402_TEST_LIMIT=20
X402_TEST_DAYS=30
X402_TEST_CATEGORY=all

# ERC-4337 smart account payer (used by `npm run test:x402:smart`).
# Smart account address must be deployed on the payment network (Base) and its
# isValidSignature(hash, signature) must recognize the bot signer EOA below.
X402_SMART_ACCOUNT_ADDRESS=
# Bot signer = the account's signer() EOA. Signs the EIP-3009 authorization.
X402_SMART_ACCOUNT_SIGNER_PRIVATE_KEY=
# Aegis accounts use EntryPoint v0.6. (Unused by the EIP-3009/EIP-1271 x402 path.)
X402_SMART_ACCOUNT_ENTRY_POINT=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# --- Aegis on-chain pre-authorization (required for Aegis accounts) ----------
# Aegis smart accounts gate isValidSignature: the exact x402 digest must be
# authorized on-chain by authorizeX402Payment() BEFORE the facilitator verifies
# it, or you get a 402 with an empty body. We authorize it WITHOUT the owner key:
# the bot signer signs an ERC-4337 UserOp (callData = authorizeX402Payment) and
# the Aegis backend relays it via EntryPoint + sponsors gas. No owner key needed.
#
# The minted permission id (bytes32) for this agent — Aegis dashboard (Permissions)
# or GET /api/v1/permissions?agent_id=<id>.
X402_AEGIS_PERMISSION_ID=
# Aegis API for the relay endpoint + an API key for the wallet that owns the agent.
AEGIS_API_BASE_URL=https://api.projectaegis.ai
AEGIS_API_KEY=
AEGIS_AGENT_ID=
# RPC used to read the EntryPoint nonce + signer() and estimate gas.
X402_BASE_RPC_URL=https://mainnet.base.org
