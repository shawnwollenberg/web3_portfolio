{
  "openapi": "3.1.0",
  "info": {
    "title": "WalletLens API",
    "version": "1.2.0",
    "description": "Paid x402 API for EVM wallet reports, normalized portfolio snapshots, canonical Robinhood Stock Token enrichment, and enriched transaction history."
  },
  "servers": [
    {
      "url": "https://walletlens.wallyweb.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "Machine-readable service status and resource index",
        "responses": {
          "200": {
            "description": "Service status, paid resources, free resources, supported chains, and docs links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/discover": {
      "get": {
        "summary": "Machine-readable agent discovery entrypoint",
        "description": "Returns WalletLens capabilities, x402 payment details, free resource links, paid resources, supported chains, and copy-paste examples for agent clients. Start here when an agent is discovering what WalletLens can do.",
        "responses": {
          "200": {
            "description": "Agent discovery payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/wallets-to-try": {
      "get": {
        "summary": "Seed wallet addresses with direct WalletLens helper and paid URLs",
        "description": "Returns a human-readable page by default and JSON when requested with Accept: application/json or format=json. Use this endpoint to find valid EVM addresses, free ask/analyze/quote URLs, and direct paid /wallet-report URLs that trigger x402 negotiation.",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["json"]
            },
            "description": "Use format=json for agent-readable seeded wallet URLs."
          }
        ],
        "responses": {
          "200": {
            "description": "Seed wallets HTML or JSON",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "get": {
        "summary": "Convert natural-language wallet intent into a paid WalletLens URL",
        "description": "Free helper for agent workflows. Use when a user asks to analyze a wallet, summarize a Base wallet, inspect token holdings, find USDC transfers, or get transaction history. The response detects an EVM address from q, recommends /wallet-report, /portfolio, or /tx-history, and returns quoteUrl plus paidUrl.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "examples": [
                "analyze wallet 0x52E29e0d2Aa49bfBfC548C0A9F2196F4aa51f3ea on base",
                "show recent USDC transfers for 0x52E29e0d2Aa49bfBfC548C0A9F2196F4aa51f3ea",
                "get token balances for 0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045 on ethereum"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Intent helper response with detected address, recommended endpoint, quoteUrl, and paidUrl",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/analyze": {
      "get": {
        "summary": "Build a paid WalletLens URL from structured wallet params",
        "description": "Free helper for agents that already have an EVM address. Returns quoteUrl, paidUrl, price, network, and x402 next steps.",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$",
              "examples": ["0x52E29e0d2Aa49bfBfC548C0A9F2196F4aa51f3ea"]
            },
            "description": "EVM wallet address."
          },
          {
            "name": "chains",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "base",
              "examples": ["base", "base,ethereum", "robinhood"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Intent helper response with quoteUrl, paidUrl, price, network, and x402 next steps",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/preview": {
      "get": {
        "summary": "Free cached live WalletLens response preview",
        "description": "Returns a cached live portfolio response for the configured demo wallet so agents can evaluate WalletLens before paying. Arbitrary wallet lookups require the paid /portfolio endpoint.",
        "responses": {
          "200": {
            "description": "Free preview payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          }
        }
      }
    },
    "/preview/robinhood": {
      "get": {
        "summary": "Free cached Robinhood Stock Token preview",
        "description": "Returns a cached live Robinhood Chain portfolio for a public example wallet. The response demonstrates canonical Stock Token matching, bid/ask quotes, corporate-action multipliers, multiplier-adjusted midpoint values, trading capabilities, and trading-halt metadata without payment.",
        "responses": {
          "200": {
            "description": "Free Robinhood Stock Token preview payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          }
        }
      }
    },
    "/pricing": {
      "get": {
        "summary": "Human-readable pricing page",
        "responses": {
          "200": {
            "description": "Pricing HTML",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/examples": {
      "get": {
        "summary": "Examples page or machine-readable examples",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["json"]
            },
            "description": "Use format=json for agent-readable examples."
          }
        ],
        "responses": {
          "200": {
            "description": "Examples HTML or JSON",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/examples/portfolio": {
      "get": {
        "summary": "Free static sample shaped like paid /portfolio",
        "description": "Returns a sample normalized portfolio response so agents can inspect the paid /portfolio response shape before making an x402 payment.",
        "responses": {
          "200": {
            "description": "Sample portfolio response wrapper",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/examples/tx-history": {
      "get": {
        "summary": "Free static sample shaped like paid /tx-history",
        "description": "Returns a sample TxLens transaction history response so agents can inspect decoded transfer rows, direction counts, labels, and pagination shape before making an x402 payment.",
        "responses": {
          "200": {
            "description": "Sample transaction history response wrapper",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/examples/wallet-report": {
      "get": {
        "summary": "Free static sample shaped like paid /wallet-report",
        "description": "Returns a sample bundled wallet report with portfolio and transaction history sections so agents can inspect the paid response before making an x402 payment.",
        "responses": {
          "200": {
            "description": "Sample wallet report response wrapper",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/x402": {
      "get": {
        "summary": "x402 discovery metadata alias",
        "description": "Alias for /.well-known/x402.json for clients that omit the .json suffix.",
        "responses": {
          "200": {
            "description": "Paid resource metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/X402Discovery"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/x402.json": {
      "get": {
        "summary": "x402 discovery metadata",
        "responses": {
          "200": {
            "description": "Paid resource metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/X402Discovery"
                }
              }
            }
          }
        }
      }
    },
    "/v2/x402/discovery/resources": {
      "get": {
        "summary": "Catalog-compatible x402 resource listing",
        "description": "Returns all WalletLens paid resources in a CDP Bazaar-compatible catalog shape. Compatibility aliases are also available at /x402/discovery/resources, /discovery/resources, /.well-known/x402/discovery/resources, and /v1/x402/discovery/resources.",
        "responses": {
          "200": {
            "description": "WalletLens x402 catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/api-catalog": {
      "get": {
        "summary": "Machine-readable API catalog",
        "description": "Returns canonical OpenAPI, x402, MCP, preview, and flagship-resource links for automated API discovery.",
        "responses": {
          "200": {
            "description": "WalletLens API catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/apis.json": {
      "get": {
        "summary": "API catalog alias",
        "description": "Alias for /.well-known/api-catalog.",
        "responses": {
          "200": {
            "description": "WalletLens API catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/quote": {
      "get": {
        "summary": "Free quote and call guidance",
        "description": "Validates an intended wallet analysis request and returns price, payment network, required parameters, and copy-paste paid endpoint examples.",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            }
          },
          {
            "name": "chains",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "base"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quote payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/portfolio": {
      "get": {
        "summary": "Get a normalized wallet portfolio snapshot",
        "description": "$0.005 USDC per call on Base (eip155:8453). WalletLens /portfolio identifies canonical Robinhood Stock Tokens on Robinhood Chain, including multiplier-adjusted midpoint USD price, bid, ask, corporate-action multiplier, and trading-halt status, plus normalized EVM balances, stablecoin totals, and top holdings. Query: address (required), chains (optional; use robinhood for Stock Tokens). For holdings and decoded transfers together, call GET /wallet-report at $0.02. Unpaid requests with a valid address return HTTP 402.",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$",
              "examples": ["0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"]
            },
            "description": "EVM wallet address."
          },
          {
            "name": "chains",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "base,ethereum",
              "examples": ["base", "base,ethereum", "base,ethereum,arbitrum,optimism,polygon", "robinhood"]
            },
            "description": "Comma-separated slugs. Token balances on base, ethereum, optimism, arbitrum, polygon, and robinhood. Canonical Robinhood Stock Token prices, bid/ask, multiplier, and trading-halt status when chains includes robinhood. recentActivity excludes Robinhood Chain. Aliases: eth, robinhood-chain, rh."
          }
        ],
        "responses": {
          "200": {
            "description": "Portfolio snapshot after successful x402 payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "402": {
            "description": "Payment required",
            "headers": {
              "payment-required": {
                "description": "Base64-encoded x402 payment requirements.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          },
          "502": {
            "description": "Upstream provider error. JSON body includes code provider_error."
          },
          "504": {
            "description": "Upstream provider timed out. JSON body includes code provider_timeout. Settlement is not completed for this response."
          }
        }
      }
    },
    "/tx-history": {
      "get": {
        "summary": "Get enriched wallet transaction history",
        "description": "$0.005 USDC per call on Base (eip155:8453). TxLens /tx-history returns normalized transfer history for Base, Ethereum, Optimism, Arbitrum, Polygon, and Robinhood Chain, with direction, counterparty, category, decoded summary, labels, and data-quality warnings. Query: address (required), chains, limit (1-100), days (1-365), category. For this history bundled with portfolio balances and Robinhood Stock Token pricing, call GET /wallet-report at $0.02. Unpaid requests with a valid address return HTTP 402.",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$",
              "examples": ["0x52E29e0d2Aa49bfBfC548C0A9F2196F4aa51f3ea"]
            },
            "description": "EVM wallet address."
          },
          {
            "name": "chains",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "base,ethereum",
              "examples": ["base", "base,ethereum", "base,ethereum,optimism,arbitrum,polygon", "robinhood"]
            },
            "description": "Comma-separated slugs. Transfer history on base, ethereum, optimism, arbitrum, polygon, and robinhood. Internal transfer traces are unavailable on robinhood. Transaction USD values are null. This route does not price Robinhood Stock Tokens."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 365
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["all", "external", "internal", "erc20", "erc721", "erc1155"],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Enriched transaction history after successful x402 payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TxHistorySnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "402": {
            "description": "Payment required",
            "headers": {
              "payment-required": {
                "description": "Base64-encoded x402 payment requirements.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          },
          "502": {
            "description": "Upstream provider error. JSON body includes code provider_error."
          },
          "504": {
            "description": "Upstream provider timed out. JSON body includes code provider_timeout. Settlement is not completed for this response."
          }
        }
      }
    },
    "/wallet-report": {
      "get": {
        "summary": "Get a bundled wallet report",
        "description": "$0.02 USDC per call on Base (eip155:8453). WalletLens /wallet-report bundles the $0.005 /portfolio snapshot and the $0.005 /tx-history feed, including canonical Robinhood Stock Token pricing and trading-halt status when chains includes robinhood. Query: address (required), chains, limit, days, category. Response includes summary.totalValueUsd, summary.topHoldings, summary.transactionCount, portfolio, and txHistory. Use /portfolio or /tx-history when only one section is needed. Unpaid requests with a valid address return HTTP 402.",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$",
              "examples": ["0x52E29e0d2Aa49bfBfC548C0A9F2196F4aa51f3ea"]
            },
            "description": "EVM wallet address."
          },
          {
            "name": "chains",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "base,ethereum",
              "examples": ["base", "base,ethereum", "base,ethereum,optimism,arbitrum,polygon", "robinhood"]
            },
            "description": "Comma-separated slugs used for both sections. Portfolio and transfer history on base, ethereum, optimism, arbitrum, polygon, and robinhood. Stock Token pricing when chains includes robinhood. recentActivity excludes Robinhood Chain. Internal traces are unavailable on robinhood."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 365
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["all", "external", "internal", "erc20", "erc721", "erc1155"],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bundled wallet report after successful x402 payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletReportSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "402": {
            "description": "Payment required",
            "headers": {
              "payment-required": {
                "description": "Base64-encoded x402 payment requirements.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          },
          "502": {
            "description": "Upstream provider error. JSON body includes code provider_error."
          },
          "504": {
            "description": "Upstream provider timed out. JSON body includes code provider_timeout. Settlement is not completed for this response."
          }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "LLM-friendly API index",
        "responses": {
          "200": {
            "description": "Markdown documentation index",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/llms-full.txt": {
      "get": {
        "summary": "Full LLM-friendly API documentation",
        "responses": {
          "200": {
            "description": "Markdown documentation",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentStatus": {
        "type": "object",
        "properties": {
          "protocol": { "type": "string", "const": "x402" },
          "scheme": { "type": "string", "const": "exact" },
          "network": { "type": "string", "description": "CAIP-2 payment network. Production is Base mainnet, eip155:8453." },
          "asset": { "type": "string", "const": "USDC" },
          "payTo": { "type": ["string", "null"] },
          "defaultPrice": { "type": "string", "description": "Price of GET /wallet-report, the highest per-call price." },
          "facilitatorUrl": { "type": "string" },
          "facilitator": { "type": "string", "enum": ["coinbase-cdp", "custom"] },
          "cdpAuthConfigured": { "type": "boolean", "description": "True when CDP API key id and secret are present. The secret is never returned." },
          "bazaarEligible": { "type": "boolean", "description": "True when settlement is configured for the Coinbase CDP facilitator on Base mainnet." },
          "pricesUsd": {
            "type": "object",
            "properties": {
              "portfolio": { "type": "string" },
              "txHistory": { "type": "string" },
              "walletReport": { "type": "string" }
            },
            "required": ["portfolio", "txHistory", "walletReport"]
          }
        },
        "required": ["protocol", "scheme", "network", "asset", "facilitatorUrl", "facilitator", "cdpAuthConfigured", "bazaarEligible", "pricesUsd"]
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "service": { "type": "string" },
          "name": { "type": "string" },
          "x402DevBypass": { "type": "boolean" },
          "payment": { "$ref": "#/components/schemas/PaymentStatus" }
        },
        "required": ["ok", "service", "name", "x402DevBypass"]
      },
      "Status": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "uptimeSeconds": { "type": "integer" },
          "baseUrl": { "type": "string" },
          "x402DevBypass": { "type": "boolean" },
          "payment": { "$ref": "#/components/schemas/PaymentStatus" },
          "paidResources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "method": { "type": "string" },
                "price": { "type": "string" },
                "network": { "type": "string" },
                "asset": { "type": "string" },
                "description": { "type": "string" }
              },
              "required": ["path", "method", "price", "network", "asset", "description"]
            }
          },
          "freeResources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "supportedChains": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Canonical slugs accepted by every paid route and the free helpers. See chainSupport for per-route limits."
          },
          "chainSupport": {
            "type": "object",
            "description": "Per-route chain acceptance and feature limits. Every paid route accepts the same six slugs."
          },
          "mcp": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "transport": { "type": "string" },
